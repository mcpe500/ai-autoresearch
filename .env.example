# ==============================================================================
# LLM Provider Configuration (e.g. 9router, OpenAI, OpenRouter, DeepSeek)
# ==============================================================================
OPENAI_API_BASE=https://api.9router.com/v1
OPENAI_API_KEY=your_api_key_here
MODEL_NAME=claude-3-7-sonnet

# ==============================================================================
# Experiment Budget & Execution Settings
# ==============================================================================
# Timeout in seconds for each experiment iteration (default 60s for cheap VPS)
EXPERIMENT_TIMEOUT_SEC=60
# Max experiments to run (0 for infinite 100+ hour loop)
MAX_EXPERIMENTS=0
# Process nice level for VPS CPU protection (0 = normal, 10 = low priority)
PROCESS_NICE=10

# ==============================================================================
# Web Server & Cloudflare Tunnel Settings
# ==============================================================================
HOST=0.0.0.0
PORT=8000
# Set to true to automatically launch Cloudflare Tunnel
ENABLE_CLOUDFLARE_TUNNEL=true
# Optional Cloudflare Tunnel Token (leave empty for quick trycloudflare.com tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
